PORT=5000
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/recruitment?retryWrites=true&w=majority"
JWT_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
# signs the email login codes; use a different random value from JWT_SECRET
OTP_SECRET="generate the same way as JWT_SECRET"
CORS_ORIGIN="http://localhost:3000"

# Email (Gmail). Without these, emails are printed to the console in development
EMAIL_USER="your_club_email@gmail.com"
EMAIL_APP_PASSWORD="16-character Gmail app password"
EMAIL_FROM="Club Recruitment Team <your_club_email@gmail.com>"
# set to production on the live server
NODE_ENV="development"

# Test-only tools (e.g. a "mark as shortlisted" button in the test frontend).
# Never set this on the live server; it is ignored when NODE_ENV=production
ENABLE_TEST_TOOLS="false"
